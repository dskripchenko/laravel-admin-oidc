{
    "name": "dskripchenko/laravel-admin-oidc",
    "description": "Sign in to dskripchenko/laravel-admin panels with OpenID Connect — Keycloak, Microsoft Entra ID, ADFS, Authentik or any OIDC provider: account provisioning, role mapping, per-tenant providers.",
    "type": "library",
    "keywords": [
        "laravel",
        "admin",
        "sso",
        "oidc",
        "openid-connect",
        "keycloak",
        "dskripchenko"
    ],
    "homepage": "https://github.com/dskripchenko/laravel-admin-oidc",
    "license": "MIT",
    "authors": [
        {
            "name": "Denis Skripchenko",
            "email": "denskrp90@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/dskripchenko/laravel-admin-oidc/issues",
        "source": "https://github.com/dskripchenko/laravel-admin-oidc"
    },
    "require": {
        "php": "^8.2",
        "dskripchenko/laravel-admin": "^1.51",
        "firebase/php-jwt": "^7.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Dskripchenko\\LaravelAdminOidc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dskripchenko\\LaravelAdminOidc\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dskripchenko\\LaravelAdminOidc\\AdminOidcServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
